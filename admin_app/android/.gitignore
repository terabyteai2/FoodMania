# ============================================
# Android .gitignore
# Only excludes large/regenerable Gradle build caches.
# key.properties, local.properties, *.jks WILL be pushed.
# ============================================

# ---------- Gradle caches (HUGE, regenerable) ----------
.gradle/
/.gradle
/captures/
.cxx/

# ---------- Build outputs (HUGE) ----------
build/
app/build/
app/debug/
app/profile/
app/release/

# ---------- Generated ----------
GeneratedPluginRegistrant.java
