# MVP consolidated env — copy to backend/.env locally (never push real secrets to GitHub).
# GitHub push protection blocks API keys; sync real values via: bash deploy/push-backend-env.sh

# ── Local development ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://USER@/DB?host=/var/run/postgresql
SECRET_KEY=change-me-local
IMAGES_DIR=./uploads/menu_images
HERO_MEDIA_DIR=./uploads/hero_media
OUTLET_IMAGES_DIR=./uploads/outlet_images
OUTLET_VIDEOS_DIR=./uploads/outlet_videos

BASE_URL=https://160-187-130-80.sslip.io
GOOGLE_CLIENT_IDS=your-google-client-ids

# Used by POST /customer/{outlet_id}/geocode/reverse — same value as
# customer_menu/frontend/.env's VITE_MAPBOX_TOKEN.
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

UDDOKTAPAY_BASE_URL=https://foodmania.paymently.io
UDDOKTAPAY_API_KEY=your-uddoktapay-key
UDDOKTAPAY_SANDBOX=false

PLATFORM_ADMIN_EMAIL=admin@food.com
PLATFORM_ADMIN_PASSWORD=change-me
STAFF_DEV_BYPASS_SECRET=rastarant-staff-dev

ONECODESOFT_API_KEY=your-onecodesoft-key
ONECODESOFT_SENDER_ID=8809617626047
ONECODESOFT_API_URL=https://sms.onecodesoft.com/api/send-sms
APP_ENV=production

# Scan Menu OCR and AI (OCR.space -> xAI -> DeepSeek -> OpenAI)
OCR_SPACE_API_KEY=your-ocr-space-key
OCR_SPACE_API_URL=https://api.ocr.space/parse/image
OCR_SPACE_ENGINE=3
OCR_SPACE_LANGUAGE=auto
GROQ_API_KEY=your-groq-key
MENU_SCAN_GROQ_MODEL=openai/gpt-oss-20b
XAI_API_KEY=your-xai-key
DEEPSEEK_API_KEY=your-deepseek-key
OPENAI_API_KEY=your-openai-key
MENU_SCAN_XAI_MODEL=grok-4.3
MENU_SCAN_DEEPSEEK_MODEL=deepseek-chat
MENU_SCAN_OPENAI_MODEL=gpt-4.1-mini

# VPS SSH / deploy
VPS_HOST=160.187.130.80
VPS_HOSTNAME=58914923.gotmyhost.com
VPS_PORT=22
VPS_USER=root
VPS_PASSWORD=your-vps-password

# ── VPS production (live server uses these paths/keys) ───────────────────────
VPS_DATABASE_URL=postgresql+asyncpg://USER:PASS@localhost:5432/rastarant
VPS_SECRET_KEY=your-vps-secret-key
VPS_IMAGES_DIR=/var/www/rastarant/backend/uploads/menu_images
VPS_HERO_MEDIA_DIR=/var/www/rastarant/backend/uploads/hero_media
VPS_OUTLET_IMAGES_DIR=/var/www/rastarant/backend/uploads/outlet_images
VPS_OUTLET_VIDEOS_DIR=/var/www/rastarant/backend/uploads/outlet_videos
VPS_TWILIO_ACCOUNT_SID=your-twilio-sid
VPS_TWILIO_AUTH_TOKEN=your-twilio-token
VPS_TWILIO_VERIFY_SERVICE_SID=your-twilio-verify-sid
