# Flutter POS: set POS_NGROK_DOMAIN (hostname) or POS_CLOUD_API_URL (full https base) to match NGROK_STATIC_DOMAIN.
# See Restuarent_POS_Admin_APP/README.md — app sends ngrok-skip-browser-warning on API calls.

# UddoktaPay / Paymently (admin subscription checkout)
# Live: https://pay.uddoktapay.com or https://your-brand.paymently.io (no /api suffix)
# Sandbox: https://sandbox.uddoktapay.com
UDDOKTAPAY_BASE_URL=https://pay.uddoktapay.com
UDDOKTAPAY_API_KEY=
UDDOKTAPAY_SANDBOX=false

# Platform admin panel (company control site)
PLATFORM_ADMIN_EMAIL=admin@yourcompany.com
PLATFORM_ADMIN_PASSWORD=change-me-to-a-strong-password
