DATABASE_URL=postgresql+asyncpg://postgres:password@localhost/rastarant
SECRET_KEY=change-me-to-a-long-random-string
IMAGES_DIR=./uploads/menu_images
# Production deployment: BDIX VPS at 103.191.240.34 (port 80 via reverse proxy).
# For local dev, use http://localhost:8000 instead.
# Public backend HTTPS origin. Use http://localhost:8000 for local dev.
BASE_URL=https://quickbytes.buzz
GOOGLE_CLIENT_IDS=17506890816-phe8hk3uo1ia5tjvaqqt06s7inu43v29.apps.googleusercontent.com,17506890816-bnmtl46m2u9mebmc1mnb37tm18sdvsit.apps.googleusercontent.com,17506890816-g9fjpo7dsv9a4nib0ar9rg0sjfcc9d42.apps.googleusercontent.com

# Mapbox access token — used by the customer-menu reverse-geocode endpoint
# (POST /customer/{outlet_id}/geocode/reverse) to turn a browser location
# into an address. Same value as customer_menu/frontend/.env's VITE_MAPBOX_TOKEN.
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

# ngrok — reserve a static hostname at https://dashboard.ngrok.com/domains
# Use bare hostname only (no https://). Must match Flutter POS_NGROK_DOMAIN or POS_CLOUD_API_URL.
# When both token + domain are set, Uvicorn disables --reload so pyngrok tunnel stays stable.
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_STATIC_DOMAIN=your-static-domain.ngrok-free.app

# Optional: port for this API (ngrok tunnel points here; default 8000).
# PORT=8000

# Flutter POS: set POS_NGROK_DOMAIN (hostname) or POS_CLOUD_API_URL (full https base) to match NGROK_STATIC_DOMAIN.
# See Restuarent_POS_Admin_APP/README.md — app sends ngrok-skip-browser-warning on API calls.

# UddoktaPay / Paymently (admin subscription checkout)
# Live: https://pay.uddoktapay.com or https://your-brand.paymently.io (no /api suffix)
# Sandbox: https://sandbox.uddoktapay.com
UDDOKTAPAY_BASE_URL=https://pay.uddoktapay.com
UDDOKTAPAY_API_KEY=
UDDOKTAPAY_SANDBOX=false

# Platform admin panel (company control site)
PLATFORM_ADMIN_EMAIL=admin@yourcompany.com
PLATFORM_ADMIN_PASSWORD=change-me-to-a-strong-password

# OPTIONAL dev-only: enables POST /admin/staff/dev-bypass-login so staff can sign in without Google.
# Flutter shows UI in debug runs or --dart-define=POS_STAFF_DEV_BYPASS=true. MUST be empty in production.o

# OneCodeSoft SMS (Bangladesh phone OTP)
ONECODESOFT_API_KEY=your_onecodesoft_api_key
ONECODESOFT_SENDER_ID=8809617626047
ONECODESOFT_API_URL=https://sms.onecodesoft.com/api/send-sms
APP_ENV=production

# Demo manager login (no SMS). Empty = enabled in development only.
# DEMO_MANAGER_LOGIN_ENABLED=true
# DEMO_MANAGER_SERVER_ID=DEMO-MANAGER

# Monitoring (optional)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# GIT_COMMIT_SHA=

# Scan Menu OCR and AI. Keep real keys in backend/.env or VPS env only, never Git.
OCR_SPACE_API_KEY=
OCR_SPACE_API_URL=https://api.ocr.space/parse/image
OCR_SPACE_ENGINE=3
OCR_SPACE_LANGUAGE=auto
GROQ_API_KEY=
MENU_SCAN_GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
# Optional comma-separated fallback pool. Keep real keys in backend/.env only.
OPENROUTER_API_KEYS=
CHATBOT_OPENROUTER_MODEL=openai/gpt-5-mini
XAI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
MENU_SCAN_XAI_MODEL=grok-4.3
MENU_SCAN_DEEPSEEK_MODEL=deepseek-chat
MENU_SCAN_OPENAI_MODEL=gpt-4.1-mini

# In-app support assistant (Volt Assistant). Independent LLM route from the
# Facebook chatbot. Empty values fall back to DeepSeek (DEEPSEEK_API_KEY +
# CHATBOT_DEEPSEEK_MODEL against https://api.deepseek.com/v1).
SUPPORT_CHAT_LLM_BASE_URL=
SUPPORT_CHAT_LLM_API_KEY=
SUPPORT_CHAT_LLM_MODEL=deepseek-chat

# Facebook Messenger chatbot
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ANDROID_CLIENT_TOKEN=
FACEBOOK_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v24.0
FACEBOOK_LOGIN_SCOPES=pages_show_list,pages_manage_metadata,pages_messaging

