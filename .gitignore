# ============================================
# Root .gitignore — Rastarant monorepo
# Goal: push everything EXCEPT large/regenerable build artifacts.
# GitHub hard limit: 100MB per file, 50MB warning.
# ============================================

# ---------- OS junk ----------
.DS_Store
Thumbs.db
*.swp
.vscode/

# ---------- Deploy secrets ----------
deploy/.deploy-secrets
deploy/.deploy-secrets.*

# ---------- Python caches (regenerable) ----------
__pycache__/
*.pyc
*.pyo
*.pyd

# ---------- Node deps (HUGE, regenerable via npm/yarn install) ----------
node_modules/

# ---------- Build outputs (regenerable) ----------
build/
dist/
.cache/
.turbo/
.vite/
.vercel/
coverage/
backend/frontend_dist/
backend/pos_dist/

# ---------- Secrets & runtime (never push) ----------
backend/.env
platform_admin/.env
customer_menu/frontend/.env
platform_admin/.env.*
backend/uploads/
backend/In_App_Update_Apk_File/
**/android/local.properties
**/android/key.properties
**/*.jks
**/*.keystore

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
cloudflared.log
ngrok.log
