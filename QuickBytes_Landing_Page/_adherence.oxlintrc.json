{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": []
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter|Noto Sans Bengali))/i]",
        "message": "Font not provided by the design system. Available: Inter, Noto Sans Bengali."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent-text",
      "--action-primary-bg",
      "--action-primary-ink",
      "--action-wash-bg",
      "--border-card",
      "--border-hairline",
      "--font-bengali",
      "--font-sans",
      "--fs-body",
      "--fs-caption",
      "--fs-display",
      "--fs-heading",
      "--fs-micro",
      "--fs-title",
      "--fw-bold",
      "--fw-medium",
      "--fw-regular",
      "--fw-semibold",
      "--hit-desktop",
      "--hit-mobile",
      "--lh-body",
      "--lh-tight",
      "--numeric-tabular",
      "--qb-accent-strong",
      "--qb-accent-wash",
      "--qb-bg",
      "--qb-danger",
      "--qb-hairline",
      "--qb-info",
      "--qb-ink",
      "--qb-ink-on-lime",
      "--qb-lime",
      "--qb-muted",
      "--qb-slate-bg",
      "--qb-slate-border",
      "--qb-slate-ink",
      "--qb-success",
      "--qb-surface",
      "--qb-warning",
      "--radius-lg",
      "--radius-md",
      "--radius-pill",
      "--radius-sm",
      "--shadow-none",
